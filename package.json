{
  "name": "leetcode-copier",
  "version": "1.21.0",
  "description": "1-click export for LeetCode problems & starter code with local offline AI Time and Space Complexity analysis (LM Studio).",
  "scripts": {
    "lint": "web-ext lint",
    "lint:strict": "web-ext lint --warnings-as-errors=true",
    "lint:json": "web-ext lint --output json > web-ext-artifacts/amo-lint-report.json || true",
    "build": "web-ext build --overwrite-dest",
    "sign:listed": "web-ext sign --channel=listed",
    "sign:unlisted": "web-ext sign --channel=unlisted",
    "sign:env": "node --env-file=.env -e \"const {execSync}=require('child_process'); execSync('npx web-ext sign --api-key=\\\"' + process.env.AMO_JWT_ISSUER + '\\\" --api-secret=\\\"' + process.env.AMO_JWT_SECRET + '\\\" --channel=listed --approval-timeout=0', {stdio: 'inherit'});\""
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "web-ext-artifacts",
    "build": {
      "overwriteDest": true
    },
    "ignoreFiles": [
      ".git/**",
      ".github/**",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "web-ext-artifacts/**",
      "scripts/**",
      "*.md",
      "*.log",
      "*.json.log",
      "amo-lint-report.json",
      "amo-sign-output.log",
      "amo-sign-error.log",
      "LICENSE"
    ]
  },
  "keywords": [
    "leetcode",
    "firefox-addon",
    "webextension",
    "lm-studio",
    "ai-complexity"
  ],
  "author": "punit",
  "license": "MIT",
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
