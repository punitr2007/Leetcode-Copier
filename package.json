{
  "name": "leetcode-copier",
  "version": "1.20.1",
  "description": "Copy LeetCode problem description, starter code, and local LLM (LM Studio) Time & Space Complexity analysis to clipboard.",
  "scripts": {
    "lint": "web-ext lint",
    "lint:strict": "web-ext lint --warnings-as-errors=true",
    "lint:json": "web-ext lint --output json > web-ext-artifacts/amo-lint-report.json || true",
    "build": "web-ext build --overwrite-dest",
    "sign:listed": "web-ext sign --channel=listed",
    "sign:unlisted": "web-ext sign --channel=unlisted"
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "web-ext-artifacts",
    "build": {
      "overwriteDest": true
    },
    "ignoreFiles": [
      ".git/**",
      ".github/**",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "web-ext-artifacts/**",
      "scripts/**",
      "*.md",
      "*.log",
      "*.json.log",
      "amo-lint-report.json",
      "amo-sign-output.log",
      "amo-sign-error.log",
      "LICENSE"
    ]
  },
  "keywords": [
    "leetcode",
    "firefox-addon",
    "webextension",
    "lm-studio",
    "ai-complexity"
  ],
  "author": "punit",
  "license": "MIT",
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
